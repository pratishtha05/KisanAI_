PROJECT_NAME="KisanAI"
API_V1_STR="/api/v1"
SECRET_KEY="your_secret_key"
DATABASE_URL="postgresql://postgres:password@localhost:5432/kisanai"
OTP_MODE="mock"
WEATHER_MODE="mock"

# llm
LLM_MODE=local
LLM_MAX_NEW_TOKENS=220
LLM_TEMPERATURE=0.15
LLM_MODEL=small
LLM_WEIGHTS_DIR_SMALL=./model_weights
LLM_WEIGHTS_DIR_MEDIUM=./model_weights_1.5b
LLM_USE_PT=true
LLM_CHECKPOINT_DIR=./checkpoints

# Knowledge base
RAG_PERSIST_DIR=./chroma_db
RAG_TOP_K=3
RAG_MIN_SIMILARITY=0.25